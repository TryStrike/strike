{
  "name": "Strike",
  "version": "0.1.0",
  "private": true,
  "_resolutions_note": "Resolutions ensure consistent cryptographic primitives for security - @noble/hashes and @noble/curves are pinned for security advisory compliance.",
  "resolutions": {
    "@noble/hashes": "^1.8.0",
    "@noble/curves": "^1.9.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:audit": "npm audit --audit-level=moderate",
    "api:dev": "BIND_ADDR=${BIND_ADDR:-127.0.0.1:8080} cargo run --manifest-path backend/Cargo.toml -p server",
    "api:build": "cargo build --release --locked --manifest-path backend/Cargo.toml -p server",
    "api:start": "backend/target/release/strike-backend",
    "api:test": "cargo test --manifest-path backend/Cargo.toml --workspace",
    "api:check": "cargo fmt --manifest-path backend/Cargo.toml --all -- --check && cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets -- -D warnings && cargo build --locked --manifest-path backend/Cargo.toml --workspace"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@privy-io/react-auth": "^2.1.0",
    "@tanstack/react-query": "^5.90.20",
    "connectkit": "^1.9.1",
    "d3-shape": "^3.2.0",
    "ethers": "^6.16.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.3",
    "posthog-js": "^1.353.1",
    "postprocessing": "^6.38.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.3.1",
    "three": "^0.182.0",
    "viem": "^2.45.2",
    "wagmi": "^3.4.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "solc": "^0.8.28",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
