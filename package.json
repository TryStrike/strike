{
  "name": "Strike",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "api:dev": "BIND_ADDR=${BIND_ADDR:-127.0.0.1:8080} cargo run --manifest-path backend/Cargo.toml -p server",
    "api:build": "cargo build --release --locked --manifest-path backend/Cargo.toml -p server",
    "api:start": "backend/target/release/strike-backend",
    "api:test": "cargo test --manifest-path backend/Cargo.toml --workspace",
    "api:check": "cargo fmt --manifest-path backend/Cargo.toml --all -- --check && cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets -- -D warnings && cargo build --locked --manifest-path backend/Cargo.toml --workspace"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@privy-io/react-auth": "^2.25.0",
    "@tanstack/react-query": "^5.105.3",
    "connectkit": "^1.9.2",
    "d3-shape": "^3.2.1",
    "ethers": "^6.17.0",
    "framer-motion": "^12.43.0",
    "next": "16.4.4",
    "posthog-js": "^1.444.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "^19.3.1",
    "viem": "^2.57.15",
    "wagmi": "^3.7.11",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "solc": "^0.8.38",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
