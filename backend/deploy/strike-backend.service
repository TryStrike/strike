[Unit]
Description=Strike backend (Rust, the only SQLite writer)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=strike
Group=strike
WorkingDirectory=/var/lib/strike
EnvironmentFile=/etc/strike/backend.env
Environment=NODE_ENV=production
Environment=BIND_ADDR=127.0.0.1:8080
Environment=SQLITE_PATH=/var/lib/strike/strike.sqlite
ExecStart=/opt/strike/bin/strike-backend
Restart=on-failure
RestartSec=5

TimeoutStopSec=420

LimitNOFILE=65536
TasksMax=4096
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/strike
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
