# =============================================================================
# ARC NETWORK CONFIGURATION
# =============================================================================

NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC_ENDPOINT=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.arc.io
NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_TREASURY_ADDRESS=0xd21fedFACC94d82722b7f4Ad67927E941B98787A

# Treasury key (Backend only - secure this!). Pays withdrawals.
ARC_TREASURY_SECRET_KEY=your-arc-treasury-secret-key

# Used by contracts/arc deploy and e2e scripts
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Optional: platform fee collector for USDC withdrawals
NEXT_PUBLIC_PLATFORM_FEE_WALLET_ARC=

# =============================================================================
# WALLETS
# =============================================================================

# WalletConnect / Reown Project ID (required for Wagmi + ConnectKit QR / mobile wallets)
# Create a project at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-reown-project-id

# Privy App ID (from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# =============================================================================
# APPLICATION
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Also the one browser origin the Rust service answers CORS for. Pages are served
# from it, so same-origin calls never need this.

# Postgres. Only the db/migrate_pg_to_sqlite tool reads this; the Rust service
# does not, and oracle.sh never ships it.
# PG_URL=postgres://user:password@host/db

# Admin dashboard
DASHBOARD_PASSWORD=your-dashboard-password
# ADMIN_SESSION_HOURS=12

# =============================================================================
# HOUSE BALANCE API (bet signing + optional request hardening)
# =============================================================================

# HMAC secret used to sign settlement tokens after a bet is placed (server only).
# Required for POST /api/balance/bet. Use a long random string (e.g. openssl rand -hex 32).
BALANCE_SETTLEMENT_SECRET=your-long-random-settlement-secret

# Required in production: long random string (server only — never NEXT_PUBLIC_*).
# The app mints an HttpOnly cookie via POST /api/balance/session; balance mutations accept that cookie
# or Authorization: Bearer <this same secret> for trusted backends/scripts.
BALANCE_INTERNAL_SECRET=your-long-random-balance-internal-secret

# =============================================================================
# BACKEND SERVICE (Rust — authoritative in production)
# =============================================================================

# Where Next proxies every /api/* request. `next build` fails without it: there
# is no other backend. `next dev` defaults to http://127.0.0.1:8080.
#
# Production (Oracle): http://127.0.0.1:8080, over the loopback interface. Never
# expose the Rust port publicly.
#
# IMPORTANT: rewrites are baked into `.next/routes-manifest.json` at build
# time. Set this for `next build`, not only for `next start`.
# BACKEND_URL=http://127.0.0.1:8080

# Where the Rust service binds. Default 0.0.0.0:8080; keep it on loopback when
# Caddy/Next are the only callers. `npm run api:dev` defaults to 127.0.0.1:8080.
# BIND_ADDR=127.0.0.1:8080

# The Rust service's SQLite file. It does not read DATABASE_URL. Keep the file on
# a local disk: WAL mode does not work over network filesystems.
# oracle.sh sets this itself and ignores any value here.
# SQLITE_PATH=/var/lib/strike/strike.sqlite
# Optional: read-only connections for the Rust service (default 8).
# SQLITE_READ_POOL=8
# Optional: per-read timeout in milliseconds (default 8000).
# SQLITE_STATEMENT_TIMEOUT_MS=8000
# Optional: "OFF" drops F_FULLFSYNC on macOS. No effect on Linux. Default on.
# SQLITE_FULLFSYNC=OFF
# Optional: tick history, a separate file that is never the ledger. Unset keeps
# ticks in memory only. oracle.sh puts it in /var/lib/strike and replaces a path
# anywhere else, because the service can only write there.
# TICKS_SQLITE_PATH=/var/lib/strike/ticks.db
# TICK_FLUSH_SECS=120
# TICK_RETENTION_DAYS=3
# TICK_RING_SECS=900
# Optional: seconds before an accepted withdrawal with no tx hash counts as stuck.
# WITHDRAWAL_STUCK_SECS=600

# Off-machine backup of the ledger. Unset, the deploy warns and carries on, and
# the only copies are on the VM's own disk. oracle.sh moves these into a root-only
# file the backend cannot read. See docs/OPERATIONS.md.
# LITESTREAM_REPLICA_URL=s3://my-bucket/strike?endpoint=https://<account>.r2.cloudflarestorage.com&region=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# The Rust service marks its cookies `Secure` only when NODE_ENV=production.
# Production units set this; local runs omit it.
# NODE_ENV=production

# =============================================================================
# POSTHOG ANALYTICS
# =============================================================================

NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# MODERATION (optional)
# =============================================================================

# Comma-separated EVM wallet addresses blocked without DB access (lowercased automatically).
# Prefer the `banned_wallets` table + admin dashboard for ongoing moderation.
# BANNED_WALLET_ADDRESSES=0xabc...
# WITHDRAWAL_FREQUENCY_REVIEW_EXEMPT_WALLETS=0xabc...
