# Copy to .env.local at the repo root. It drives the Rust backend and the Next app.
# Never commit .env.local.

# --- Arc (defaults are Arc Testnet, override only to point elsewhere) --------
# NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# NEXT_PUBLIC_ARC_RPC_ENDPOINT=https://rpc.testnet.arc.network
# NEXT_PUBLIC_ARC_EXPLORER=https://explorer.testnet.arc.io
# NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# NEXT_PUBLIC_ARC_EURC_ADDRESS=0x89B50855Aa3bE2F677cD6303Cec089B5F319D72a

# --- Treasury -----------------------------------------------------------------
NEXT_PUBLIC_TREASURY_ADDRESS=
# Owner key of the treasury above. Server only, pays withdrawals.
ARC_TREASURY_SECRET_KEY=
# Optional fee collector for deposit and withdrawal fees.
# NEXT_PUBLIC_PLATFORM_FEE_WALLET_ARC=

# --- Settlement proofs ------------------------------------------------------------
# First 10 minute epoch the committer writes to commitRounds. The committer runs
# only with ARC_TREASURY_SECRET_KEY set. Current epoch: floor(unix ms / 600000).
PROOFS_START_EPOCH=

# --- Backend ------------------------------------------------------------------
# SQLite ledger. Local disk only, WAL does not work over network filesystems.
# On the EC2 VM, backend/deploy/vm.sh sets its own path.
SQLITE_PATH=./tmp/strike.sqlite
# HMAC for settlement tokens and the balance session. openssl rand -hex 32
BALANCE_SETTLEMENT_SECRET=
BALANCE_INTERNAL_SECRET=
# Admin dashboard at /dashboard.
DASHBOARD_PASSWORD=
# Browser origin the backend answers CORS for.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# World ID. IDKit verifies a human once, on the first money action (bet, agent start,
# withdrawal), and every wallet links to that human. IDKit app from developer.world.org.
# The app id is public, the RP signing key is backend only and signs each request.
NEXT_PUBLIC_WORLD_APP_ID=app_ab0b5af80ebfc9f21c2bc48a744c2939
WORLD_RP_ID=rp_fffa8c989c458e63
WORLD_RP_SIGNING_KEY=
# production, or staging for the simulator at https://simulator.worldcoin.org
WORLD_ENVIRONMENT=production
# WORLD_VERIFY_URL=https://developer.world.org
# The IDKit action, so the nullifier is one stable id per human.
WORLD_ACTION=strike-human
# Agent Pass (OIDC device flow): a fresh human approval before a YOLO start, at 50% and
# 75% of the stop-loss, on a loss chase, and for proposals and withdrawals over the caps.
# https://sandbox.auth.world.org for the sandbox. Production needs an Orb level account.
WORLD_AP_ISSUER=https://auth.world.org
WORLD_AP_CLIENT_ID=
WORLD_AP_CLIENT_SECRET=
WORLD_AP_ACR=orb
# Per-human caps in USDC, counted across every wallet the human links.
WORLD_SELFIE_OPEN_CAP=5
WORLD_SELFIE_DAILY_LOSS=25
WORLD_ORB_OPEN_CAP=50
WORLD_ORB_DAILY_LOSS=200
WORLD_COOLOFF_MIN=30
# Step-ups above these amounts, and how long a step-up waits for the human.
STEPUP_WITHDRAW_OVER=25
STEPUP_PROPOSAL_OVER=5
HUMAN_WAIT_MS=120000

# --- AI ----------------------------------------------------------------------
# Copilot. Without it /api/copilot answers 503.
ANTHROPIC_API_KEY=

# --- Circle -------------------------------------------------------------------
# Passkey login (Modular Wallets). Client key from console.circle.com, allowed
# domain and passkey domain must match the site (localhost for local).
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# --- Frontend -----------------------------------------------------------------
# Where Next proxies /api/*. next build bakes it in, next dev defaults to this.
# BACKEND_URL=http://127.0.0.1:8080
# Reown project id for WalletConnect QR and mobile wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Optional tuning, defaults shown ------------------------------------------
# BIND_ADDR=127.0.0.1:8080
# NODE_ENV=production            # Secure cookies. Production units set it.
# ADMIN_SESSION_HOURS=8
# SQLITE_READ_POOL=8
# SQLITE_STATEMENT_TIMEOUT_MS=8000
# SQLITE_FULLFSYNC=OFF           # macOS only
# TICKS_SQLITE_PATH=             # tick history file, unset keeps ticks in memory
# TICK_FLUSH_SECS=120
# TICK_RETENTION_DAYS=3
# TICK_RING_SECS=900
# WITHDRAWAL_STUCK_SECS=600
# BANNED_WALLET_ADDRESSES=0xabc,0xdef
# WITHDRAWAL_FREQUENCY_REVIEW_EXEMPT_WALLETS=0xabc

# --- Off-machine ledger backup (deploy only, see docs/OPERATIONS.md) ----------
# LITESTREAM_REPLICA_URL=s3://bucket/strike?endpoint=https://<account>.r2.cloudflarestorage.com&region=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Arkiv (Rabdi testnet). The operator is the public address of ARKIV_PRIVATE_KEY.
ARKIV_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
NEXT_PUBLIC_ARKIV_OPERATOR=

# jev gate for agent trades. Leave unset to let the rule decide alone.
OPENROUTER_API_KEY=

# House limits on bets, in USDC.
# MAX_STAKE=100
# MAX_WALLET_OPEN_STAKE=300

# --- Swarm (optional) -----------------------------------------------------------
# Bee node or gateway each committed epoch bundle uploads to; its reference goes on
# the epoch's Arkiv entity. SWARM_BATCH_ID is the postage batch to stamp with.
SWARM_BEE_URL=
SWARM_BATCH_ID=

# TestStockMarket on Arc testnet (testnet simulation of buying stocks; quotes signed by the treasury operator)
NEXT_PUBLIC_STOCK_MARKET_ADDRESS=0xd9f98f3b268e788f3ccf6e7ced2d592a84a6f80f
# Where proof cards open Swarm bundles: the public gateway for mainnet batches, your Bee node for testnet ones.
NEXT_PUBLIC_SWARM_GATEWAY=
