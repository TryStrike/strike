# =============================================================================
# ARC NETWORK CONFIGURATION
# =============================================================================

NEXT_PUBLIC_ARC_CHAIN_ID=5042
NEXT_PUBLIC_ARC_RPC_ENDPOINT=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_EXPLORER=https://explorer.arc.io
NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_TREASURY_ADDRESS=0xd21fedFACC94d82722b7f4Ad67927E941B98787A

# Treasury key (Backend only - secure this!). Pays withdrawals.
ARC_TREASURY_SECRET_KEY=your-arc-treasury-secret-key

# Used by contracts/arc deploy and e2e scripts
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Optional: platform fee collector for USDC withdrawals
NEXT_PUBLIC_PLATFORM_FEE_WALLET_ARC=

# =============================================================================
# WALLETS
# =============================================================================

# WalletConnect / Reown Project ID (required for Wagmi + ConnectKit QR / mobile wallets)
# Create a project at https://cloud.reown.com (formerly WalletConnect Cloud)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-reown-project-id

# Privy App ID (from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id

# =============================================================================
# APPLICATION
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres (Neon) connection string
DATABASE_URL=postgres://user:password@host/db
# Optional: pg pool size
# PGPOOL_MAX=10

# Admin dashboard
DASHBOARD_PASSWORD=your-dashboard-password
# ADMIN_SESSION_HOURS=12

# =============================================================================
# HOUSE BALANCE API (bet signing + optional request hardening)
# =============================================================================

# HMAC secret used to sign settlement tokens after a bet is placed (server only).
# Required for POST /api/balance/bet. Use a long random string (e.g. openssl rand -hex 32).
BALANCE_SETTLEMENT_SECRET=your-long-random-settlement-secret

# Required in production: long random string (server only — never NEXT_PUBLIC_*).
# The app mints an HttpOnly cookie via POST /api/balance/session; balance mutations accept that cookie
# or Authorization: Bearer <this same secret> for trusted backends/scripts.
BALANCE_INTERNAL_SECRET=your-long-random-balance-internal-secret

# =============================================================================
# POSTHOG ANALYTICS
# =============================================================================

NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# MODERATION (optional)
# =============================================================================

# Comma-separated EVM wallet addresses blocked without DB access (lowercased automatically).
# Prefer the `banned_wallets` table + admin dashboard for ongoing moderation.
# BANNED_WALLET_ADDRESSES=0xabc...
# WITHDRAWAL_FREQUENCY_REVIEW_EXEMPT_WALLETS=0xabc...
